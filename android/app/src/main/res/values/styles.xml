<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme (edge-to-edge: transparent bars so .app-shell
         bg-void paints continuously under the status bar and nav bar;
         see references/theme-media-header-work.md and native/shell-theme.ts).
         The bar BACKGROUND is never set from native code — it is the active
         theme's void color shown through transparent bars, which is exactly
         the contract the owner has required across every palette change.) -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <!-- Android's system-bar CONTRAST SCRIM. Left at the default (true) the
             system composites a translucent light/dark scrim over the navigation
             bar whenever it judges the app content behind it "too similar" — which
             is exactly the near-white strip the owner sees at the bottom while the
             rest of the app is tinted. Transparent bar colors alone do NOT stop it.
             Both must be false so the bar shows the page's own theme colour. -->
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <!-- Full-bleed contract: the WebView fills the screen edge-to-edge and the PAGE paints
             the theme colour under both system bars (.app-shell carries bg-void + the native
             insets as PADDING, so its background extends beneath the bars).
             This MUST be transparent. Capacitor's SystemBars.setStyle() (which we call to set
             bar icon contrast) does:
                 decorView.setBackgroundColor(getThemeColor(context, android.R.attr.windowBackground))
             so whatever windowBackground resolves to gets painted over the whole window on every
             setStyle call. With it unset it inherits AppCompat's default - WHITE - which is
             exactly the "static white navbar/status bar" regression. Transparent lets the
             theme-driven page colour show through, so every current and future theme is covered
             automatically. -->
        <item name="android:windowBackground">@android:color/transparent</item>
        <!-- Same contrast-scrim opt-out as AppTheme: this is the theme BridgeActivity
             actually applies at runtime (it calls setTheme(R.style.AppTheme_NoActionBar)),
             so the attributes must live here too or the scrim returns. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
    </style>

    <style name="AppTheme.GatePopup" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
