    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://astra-windows.jitinnair.com/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNFOTUzNkU3NDk5OTVGNTMKUldSVFg1bEo1emFWUHFrUzlsT2Fpck14TTB1cVUwUFc0U3laNUJDMUdNZ2RoaDBWVXlEY0tKeFoK",
      "windows": { "installMode": "passive" }
    },
    "deep-link": { "desktop": { "schemes": ["astra"] } }
  }
}
